{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/transaction-work-extension/0.1",
  "title": "TransactionWorkExtension",
  "required": [
    "schema_version",
    "mode",
    "representing_party",
    "document_stage",
    "maturity_state"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "mode": {
      "enum": [
        "TRANSACTION_ANALYSIS",
        "DRAFT",
        "REVIEW",
        "REVISE",
        "NEGOTIATION_SUPPORT",
        "FINAL_QA",
        "AMENDMENT",
        "TERMINATION",
        "SETTLEMENT_DOCUMENT",
        "TEMPLATE_DESIGN"
      ]
    },
    "representing_party": {
      "type": "string"
    },
    "counterparties": {
      "type": "array"
    },
    "negotiation_leverage": {
      "enum": [
        "STRONG",
        "BALANCED",
        "WEAK",
        "UNKNOWN"
      ]
    },
    "risk_tolerance": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "business_goal": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_stage": {
      "enum": [
        "CONCEPT",
        "INTERNAL_SAMPLE",
        "FIRST_DRAFT",
        "NEGOTIATION",
        "PRE_SIGNING",
        "SIGNED",
        "PERFORMANCE",
        "AMENDMENT",
        "TERMINATION"
      ]
    },
    "document_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_documents": {
      "type": "array"
    },
    "maturity_state": {
      "enum": [
        "STRONG",
        "PARTIAL",
        "LIMITED"
      ]
    },
    "extensions": {
      "type": "object"
    }
  }
}