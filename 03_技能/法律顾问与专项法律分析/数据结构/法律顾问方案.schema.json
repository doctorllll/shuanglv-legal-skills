{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/advisory-option/0.1",
  "title": "AdvisoryOption",
  "required": [
    "schema_version",
    "option_id",
    "matter_id",
    "option",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "option_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "option": {
      "type": "string"
    },
    "legal_basis": {
      "type": "array"
    },
    "assumptions": {
      "type": "array"
    },
    "required_actions": {
      "type": "array"
    },
    "advantages": {
      "type": "array"
    },
    "disadvantages": {
      "type": "array"
    },
    "legal_risks": {
      "type": "array"
    },
    "implementation_risks": {
      "type": "array"
    },
    "time_cost": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "reversibility": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array"
    },
    "fallback": {
      "type": [
        "string",
        "null"
      ]
    },
    "client_decision_required": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "PREFERRED",
        "FALLBACK",
        "REJECTED",
        "HUMAN_REVIEW"
      ]
    },
    "extensions": {
      "type": "object"
    }
  }
}