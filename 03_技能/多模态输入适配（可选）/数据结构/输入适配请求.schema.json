{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/multimodal-input-adapter/request/0.1",
  "title": "InputAdapterRequest",
  "required": [
    "schema_version",
    "asset_refs",
    "required_representation",
    "privacy_class"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "asset_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_representation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "locator_requirement": {
      "type": "string"
    },
    "quality_requirement": {
      "type": "string"
    },
    "privacy_class": {
      "type": "string"
    },
    "preferred_provider_or_skill": {
      "type": [
        "string",
        "null"
      ]
    },
    "external_processing_allowed": {
      "type": "boolean"
    },
    "extensions": {
      "type": "object"
    }
  }
}