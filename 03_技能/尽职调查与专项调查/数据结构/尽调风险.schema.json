{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/dd-risk/0.1",
  "title": "DDRisk",
  "required": [
    "schema_version",
    "risk_id",
    "matter_id",
    "scenario",
    "impact",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "risk_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "trigger": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_finding_ids": {
      "type": "array"
    },
    "likelihood": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN",
        "NOT_ASSESSED"
      ]
    },
    "impact": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "transaction_relevance": {
      "enum": [
        "DEAL_BREAKER",
        "MATERIAL",
        "MODERATE",
        "LOW",
        "UNKNOWN"
      ]
    },
    "controllability": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "source_confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNRESOLVED"
      ]
    },
    "mitigation": {
      "type": "array"
    },
    "residual_risk": {
      "type": [
        "string",
        "null"
      ]
    },
    "transaction_responses": {
      "type": "array"
    },
    "decision_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "MITIGATED",
        "ACCEPTED",
        "TRANSFERRED",
        "AVOIDED",
        "HUMAN_REVIEW"
      ]
    },
    "extensions": {
      "type": "object"
    }
  }
}