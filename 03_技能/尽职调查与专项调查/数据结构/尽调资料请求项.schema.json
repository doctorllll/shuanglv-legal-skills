{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/dd-request-item/0.1",
  "title": "DDRequestItem",
  "required": [
    "schema_version",
    "request_id",
    "matter_id",
    "item",
    "priority",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "request_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "item": {
      "type": "string"
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "received_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "REQUESTED",
        "PARTIAL",
        "RECEIVED",
        "NOT_AVAILABLE",
        "REFUSED",
        "NOT_APPLICABLE"
      ]
    },
    "quality_state": {
      "enum": [
        "UNREVIEWED",
        "COMPLETE",
        "INCOMPLETE",
        "UNREADABLE",
        "QUESTIONABLE",
        "VERIFIED"
      ]
    },
    "follow_up": {
      "type": "array"
    },
    "extensions": {
      "type": "object"
    }
  }
}