{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/civil-stage-state/0.1",
  "title": "CivilStageState",
  "required": [
    "schema_version",
    "matter_id",
    "stage",
    "stage_objectives",
    "open_tasks",
    "last_updated"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "matter_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "stage_objectives": {
      "type": "array"
    },
    "open_tasks": {
      "type": "array"
    },
    "completed_tasks": {
      "type": "array"
    },
    "critical_deadlines": {
      "type": "array"
    },
    "required_inputs": {
      "type": "array"
    },
    "missing_inputs": {
      "type": "array"
    },
    "current_findings": {
      "type": "array"
    },
    "strategy_decisions": {
      "type": "array"
    },
    "settlement_authority": {
      "type": [
        "object",
        "null"
      ]
    },
    "human_review_points": {
      "type": "array"
    },
    "next_stage_triggers": {
      "type": "array"
    },
    "last_updated": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  }
}