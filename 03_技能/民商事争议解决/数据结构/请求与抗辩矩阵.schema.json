{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/claim-defense-matrix/0.1",
  "title": "ClaimDefenseMatrix",
  "required": [
    "schema_version",
    "matrix_id",
    "matter_id",
    "relief",
    "claimant_position",
    "claim_basis_candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "matrix_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "relief": {
      "type": "string"
    },
    "claimant_position": {
      "type": "string"
    },
    "claim_basis_candidates": {
      "type": "array"
    },
    "positive_elements": {
      "type": "array"
    },
    "auxiliary_rules": {
      "type": "array"
    },
    "defenses": {
      "type": "array"
    },
    "counter_defenses": {
      "type": "array"
    },
    "further_replies": {
      "type": "array"
    },
    "party_assertions": {
      "type": "array"
    },
    "disputed_propositions": {
      "type": "array"
    },
    "proof_burden_links": {
      "type": "array"
    },
    "evidence_links": {
      "type": "array"
    },
    "alternative_or_competing_bases": {
      "type": "array"
    },
    "strategy_status": {
      "enum": [
        "OPEN",
        "PROVISIONAL",
        "HUMAN_REVIEW",
        "CONFIRMED"
      ]
    },
    "extensions": {
      "type": "object"
    }
  }
}