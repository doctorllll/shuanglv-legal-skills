{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/criminal-matter-extension/0.1",
  "title": "CriminalMatterExtension",
  "required": [
    "schema_version",
    "role",
    "stage",
    "maturity_state"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "role": {
      "enum": [
        "DEFENSE",
        "VICTIM_REPRESENTATION",
        "ACCUSATION_REPORTING",
        "PRIVATE_PROSECUTION",
        "INCIDENTAL_CIVIL",
        "OTHER_CRIMINAL_AGENT"
      ]
    },
    "stage": {
      "enum": [
        "PRE_CASE",
        "FILING_OR_ACCEPTANCE",
        "INVESTIGATION",
        "ARREST_REVIEW",
        "POST_ARREST_DETENTION",
        "PROSECUTION_REVIEW",
        "PRETRIAL",
        "TRIAL_FIRST_INSTANCE",
        "APPEAL_SECOND_INSTANCE",
        "RETRIAL_COMPLAINT",
        "DEATH_PENALTY_REVIEW",
        "EXECUTION_PROPERTY",
        "CLOSED"
      ]
    },
    "suspected_or_charged_offenses": {
      "type": "array"
    },
    "offense_status": {
      "enum": [
        "KNOWN",
        "PARTIAL",
        "UNKNOWN",
        "DISPUTED"
      ]
    },
    "custody_or_measure": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "detention_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "procedural_authorities": {
      "type": "array"
    },
    "critical_dates": {
      "type": "array"
    },
    "special_case_flags": {
      "type": "array",
      "items": {
        "enum": [
          "MINOR",
          "FOREIGN_RELATED",
          "DEATH_PENALTY",
          "STATE_SECRET",
          "MENTAL_HEALTH",
          "PLEA_LENIENCY",
          "COMPLEX_CO_DEFENDANT",
          "ELECTRONIC_EVIDENCE",
          "PROPERTY_INTENSIVE",
          "OTHER"
        ]
      }
    },
    "maturity_state": {
      "enum": [
        "STRONG",
        "PARTIAL",
        "LIMITED"
      ]
    },
    "extensions": {
      "type": "object"
    }
  }
}