{
  "schema_version": "0.1",
  "system": "爽律 Skill｜律师专业工作流系统",
  "contracts": [
    {
      "id": "BC-FACT-01",
      "critical": true,
      "rule": "ALLEGED、INFERRED、UNKNOWN 不得静默提升为 VERIFIED"
    },
    {
      "id": "BC-MAT-01",
      "critical": true,
      "rule": "RECEIVED 不得冒充 REVIEWED"
    },
    {
      "id": "BC-LOC-01",
      "critical": true,
      "rule": "重要事实、法律和案例保留可回查来源定位"
    },
    {
      "id": "BC-LAW-01",
      "critical": true,
      "rule": "要求现行法时必须真实核验权威来源"
    },
    {
      "id": "BC-CASE-01",
      "critical": true,
      "rule": "案例支持重要结论时说明决定性相似点、区别点和使用目的"
    },
    {
      "id": "BC-ISSUE-01",
      "critical": true,
      "rule": "复杂问题先形成可处理的问题结构"
    },
    {
      "id": "BC-REVIEW-01",
      "critical": true,
      "rule": "多文件比较使用任务驱动审阅问题集"
    },
    {
      "id": "BC-ARG-01",
      "critical": true,
      "rule": "重要结论保留规则—事实—证据—推理—结论连接"
    },
    {
      "id": "BC-COUNTER-01",
      "critical": true,
      "rule": "重要结论构建真实竞争解释或最强反方"
    },
    {
      "id": "BC-ADV-01",
      "critical": true,
      "rule": "对抗审查发现重要问题后修订原分析或说明维持理由"
    },
    {
      "id": "BC-OPTION-01",
      "critical": true,
      "rule": "重大策略选项使用一致维度比较并保留人工决定边界"
    },
    {
      "id": "BC-EXT-01",
      "critical": true,
      "rule": "敏感材料外部处理需要与供应方、目的和范围对应的明确授权"
    },
    {
      "id": "BC-CAP-01",
      "critical": true,
      "rule": "不得声称未经验证的工具能力已经实现"
    },
    {
      "id": "BC-PLAN-01",
      "critical": false,
      "rule": "复杂任务形成可见计划，非必要不反复要求确认"
    },
    {
      "id": "BC-WRITEBACK-01",
      "critical": true,
      "rule": "新事实或规则改变原判断时必须回写受影响对象"
    },
    {
      "id": "BC-CAP-02",
      "rule": "用户知识库结果不得自动升级为现行法或已核验案件事实",
      "critical": true
    },
    {
      "id": "BC-CAP-03",
      "rule": "工具能力不足时必须等价替代、明示降级或阻断，不得静默冒充完成",
      "critical": true
    },
    {
      "id": "BC-CAP-04",
      "critical": true,
      "rule": "未实际调用的数据库、知识库或外部工具不得声称已使用"
    }
  ]
}
