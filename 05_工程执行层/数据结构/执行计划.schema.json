{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schema/execution-plan/0.2",
  "title": "爽律 Skill 执行计划 v0.2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "task",
    "route_status",
    "lead_skill",
    "supporting_skills",
    "context",
    "load_plan"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "task": {
      "type": "string"
    },
    "route_status": {
      "enum": [
        "RESOLVED",
        "USER_OVERRIDE",
        "UNRESOLVED"
      ]
    },
    "lead_skill": {
      "type": [
        "string",
        "null"
      ]
    },
    "route_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supporting_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "important_task": {
          "type": "boolean"
        },
        "formal_delivery": {
          "type": "boolean"
        },
        "requires_current_law": {
          "type": "boolean"
        },
        "input_capability_gap": {
          "type": "boolean"
        },
        "sensitive_material": {
          "type": "boolean"
        },
        "structured_review_required": {
          "type": "boolean"
        },
        "strategy_choice_required": {
          "type": "boolean"
        },
        "cross_module_required": {
          "type": "boolean"
        }
      }
    },
    "load_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level",
          "files"
        ],
        "properties": {
          "level": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
