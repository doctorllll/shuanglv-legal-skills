{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/activation-decision/0.2",
  "title": "ActivationDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "activation_mode",
    "trigger_type",
    "confidence_tier",
    "reasons"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "decision": {
      "enum": [
        "AUTO_ACTIVATE",
        "CONFIRM",
        "MANUAL_ONLY",
        "DO_NOT_ACTIVATE",
        "EXPLICIT_ACTIVATE",
        "LEGACY_FALLBACK"
      ]
    },
    "activation_mode": {
      "enum": [
        "AUTO",
        "CONFIRM",
        "MANUAL",
        "BYPASS",
        "UNKNOWN"
      ]
    },
    "trigger_type": {
      "enum": [
        "EXPLICIT_ALIAS",
        "SEMANTIC_PROFESSIONAL_LEGAL",
        "BOUNDARY_LEGAL",
        "USER_OPT_OUT",
        "NON_LEGAL",
        "FEATURE_DISABLED",
        "ACTIVATION_ERROR"
      ]
    },
    "confidence_tier": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "NONE"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "matched_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "show_notice": {
      "type": "boolean"
    },
    "user_preference_applied": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legacy_fallback": {
      "type": "object",
      "properties": {
        "used": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "used",
        "reason"
      ],
      "additionalProperties": true
    }
  }
}
