{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/output-contract/0.1",
  "title": "OutputContract",
  "required": [
    "schema_version",
    "primary_format",
    "document_type",
    "edit_mode"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "primary_format": {
      "type": "string"
    },
    "delivery_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "editable_source_format": {
      "type": [
        "string",
        "null"
      ]
    },
    "machine_readable_format": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_type": {
      "type": "string"
    },
    "edit_mode": {
      "enum": [
        "NEW_DRAFT",
        "CLEAN_REWRITE",
        "REDLINE",
        "TRACK_CHANGES",
        "COMMENT_REVIEW",
        "FORMAT_ONLY"
      ]
    },
    "house_style": {
      "type": [
        "string",
        "null"
      ]
    },
    "citation_style": {
      "type": [
        "string",
        "null"
      ]
    },
    "version_required": {
      "type": "boolean"
    },
    "track_changes_required": {
      "type": "boolean"
    },
    "comments_required": {
      "type": "boolean"
    },
    "clean_copy_required": {
      "type": "boolean"
    },
    "diff_copy_required": {
      "type": "boolean"
    },
    "confidentiality_marking": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    }
  }
}