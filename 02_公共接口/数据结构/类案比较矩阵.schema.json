{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/case-matrix/0.1",
  "title": "类案比较矩阵 CaseMatrix v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "matrix_id",
    "matter_id",
    "issue_id",
    "rows",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "matrix_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "issue_id": {
      "type": "string"
    },
    "comparison_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "usage_type",
          "similarities",
          "differences"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "key_facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "holding": {
            "type": [
              "string",
              "null"
            ]
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "similarities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "differences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usage_type": {
            "enum": [
              "SUPPORTING",
              "COUNTER",
              "DISTINGUISHING",
              "BOUNDARY",
              "PROCEDURAL",
              "SENTENCING_OR_CONSEQUENCE",
              "OTHER"
            ]
          },
          "adverse_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locator_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "matrix_conclusion": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "COMPLETE",
        "INCOMPLETE",
        "BLOCKED"
      ]
    }
  }
}
