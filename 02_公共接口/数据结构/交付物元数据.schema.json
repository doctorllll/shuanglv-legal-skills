{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/artifact-metadata/0.1",
  "title": "ArtifactMetadata",
  "required": [
    "schema_version",
    "artifact_id",
    "document_id",
    "title",
    "version",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "artifact_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "INTERNAL_REVIEW",
        "CLIENT_REVIEW",
        "FINAL",
        "SUPERSEDED",
        "ARCHIVED"
      ]
    },
    "parent_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "modified_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "author_or_agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "change_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_change": {
      "type": "boolean"
    },
    "legal_basis_change": {
      "type": "boolean"
    },
    "rendering_change": {
      "type": "boolean"
    },
    "source_matter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_contract": {
      "type": [
        "object",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    }
  }
}