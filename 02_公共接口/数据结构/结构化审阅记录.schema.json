{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/structured-review-record.schema.json",
  "title": "结构化审阅记录 StructuredReviewRecord v0.2",
  "type": "object",
  "required": [
    "review_id",
    "material_id",
    "domain",
    "review_status"
  ],
  "properties": {
    "review_id": {
      "type": "string"
    },
    "material_id": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "enum": [
        "CRIMINAL",
        "CIVIL_COMMERCIAL",
        "CONTRACT",
        "DUE_DILIGENCE",
        "ADVISORY",
        "LEGAL_RESEARCH",
        "OTHER"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "REVIEWED",
        "PARTIAL",
        "UNREADABLE"
      ]
    },
    "source_locators": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "key_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supporting_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adverse_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "information_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_fact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domain_extension": {
      "type": "object"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "question_set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "question_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "answer_state"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "answer_state": {
            "enum": [
              "ANSWERED",
              "UNKNOWN",
              "NOT_FOUND",
              "NOT_APPLICABLE",
              "NEEDS_REVIEW"
            ]
          },
          "answer": {
            "type": [
              "string",
              "number",
              "boolean",
              "array",
              "object",
              "null"
            ]
          },
          "source_locator_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
