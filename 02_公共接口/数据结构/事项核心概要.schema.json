{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schema/matter-snapshot/0.1",
  "title": "MatterSnapshot",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "snapshot_id",
    "matter_id",
    "one_sentence_summary",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "snapshot_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "one_sentence_summary": {
      "type": "string"
    },
    "matter_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "key_elements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "business_or_fact_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "key_dates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "key_amounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "core_concerns": {
      "type": "array",
      "maxItems": 7
    },
    "unknowns": {
      "type": "array"
    },
    "diagram_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverable_navigation": {
      "type": "array"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEWED",
        "FINAL",
        "NEEDS_UPDATE"
      ]
    },
    "extensions": {
      "type": "object"
    }
  }
}
