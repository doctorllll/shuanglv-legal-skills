{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/research-deliverable-profile/0.1",
  "title": "研究交付物配置 ResearchDeliverableProfile v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "profile_id",
    "deliverable_type",
    "audience",
    "purpose",
    "template_resolution"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "deliverable_type": {
      "enum": [
        "CASE_RESEARCH_REPORT",
        "LEGAL_RESEARCH_MEMO",
        "LEGAL_OPINION_INPUT",
        "NORM_HISTORY_REPORT",
        "JUDICIAL_TREND_ANALYSIS",
        "RESEARCH_PACKAGE_ONLY"
      ]
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "required_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sample_scope_disclosure_required": {
      "type": "boolean"
    },
    "search_method_disclosure_required": {
      "type": "boolean"
    },
    "template_resolution": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "MATTER_TEMPLATE",
            "USER_TEMPLATE",
            "SYSTEM_DEFAULT",
            "USER_ONE_TIME_CHOICE"
          ]
        },
        "template_asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "preserve_user_style": {
          "type": "boolean"
        },
        "conflict_state": {
          "enum": [
            "NONE",
            "RESOLVED",
            "UNRESOLVED"
          ]
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
