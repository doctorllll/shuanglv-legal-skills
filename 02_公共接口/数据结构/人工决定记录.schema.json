{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/decision-record/0.1",
  "title": "人工决定记录 DecisionRecord v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version","decision_id","matter_id","question","decision_level","status"],
  "properties": {
    "schema_version": {"const":"0.1"},
    "decision_id": {"type":"string","minLength":1},
    "matter_id": {"type":"string","minLength":1},
    "issue_id": {"type":["string","null"]},
    "question": {"type":"string","minLength":1},
    "decision_level": {"enum":["A","B","C","D"]},
    "option_ids": {"type":"array","items":{"type":"string"}},
    "professional_recommendation": {"type":["string","null"]},
    "recommendation_basis_argument_ids": {"type":"array","items":{"type":"string"}},
    "known_consequences": {"type":"array","items":{"type":"string"}},
    "information_gaps": {"type":"array","items":{"type":"string"}},
    "selected_option_id": {"type":["string","null"]},
    "decision_by": {"type":["string","null"]},
    "decision_at": {"type":["string","null"]},
    "decision_note": {"type":["string","null"]},
    "writeback_required": {"type":"boolean"},
    "status": {"enum":["OPEN","AWAITING_HUMAN","RESOLVED","PROHIBITED"]},
    "extensions": {"type":"object"}
  },
  "allOf": [
    {
      "if": {"properties":{"decision_level":{"const":"C"}},"required":["decision_level"]},
      "then": {"properties":{"status":{"enum":["AWAITING_HUMAN","RESOLVED"]}}}
    },
    {
      "if": {"properties":{"decision_level":{"const":"D"}},"required":["decision_level"]},
      "then": {"properties":{"status":{"const":"PROHIBITED"}}}
    },
    {
      "if": {"properties":{"status":{"const":"RESOLVED"}},"required":["status"]},
      "then": {"required":["decision_by","decision_at"]}
    }
  ]
}
