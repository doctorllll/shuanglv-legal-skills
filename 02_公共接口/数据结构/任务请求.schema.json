{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/task-request/0.1",
  "title": "TaskRequest",
  "required": [
    "schema_version",
    "task_id",
    "matter_id",
    "objective",
    "requested_scope",
    "inputs",
    "assumptions_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "task_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "requested_scope": {
      "type": [
        "string",
        "object"
      ]
    },
    "explicit_constraints": {
      "type": "array"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_contract": {
      "type": [
        "object",
        "null"
      ]
    },
    "inputs": {
      "type": "array"
    },
    "assumptions_allowed": {
      "type": "boolean"
    },
    "human_review_required": {
      "type": "boolean"
    },
    "extensions": {
      "type": "object"
    }
  }
}