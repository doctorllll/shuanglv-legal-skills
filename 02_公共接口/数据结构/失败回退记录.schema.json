{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schema/failure-fallback-record.schema.json",
  "title": "FailureFallbackRecord｜失败回退记录",
  "type": "object",
  "required": [
    "schema_version",
    "feature",
    "failure_reason",
    "fallback_path",
    "fallback_status",
    "task_continuation"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "feature": {
      "type": "string",
      "enum": [
        "AUTO_ACTIVATION",
        "SKILL_ROUTER_V2",
        "MULTI_SKILL_COLLABORATION",
        "PROACTIVE_SUGGESTION",
        "OTHER_ENHANCEMENT"
      ]
    },
    "failure_reason": {
      "type": "string",
      "minLength": 1
    },
    "fallback_path": {
      "type": "string",
      "minLength": 1
    },
    "fallback_status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "DOWNGRADED",
        "BLOCKED",
        "NOT_NEEDED"
      ]
    },
    "task_continuation": {
      "type": "boolean"
    },
    "user_impact": {
      "type": "string",
      "enum": [
        "NONE",
        "LOSS_OF_ENHANCEMENT_ONLY",
        "DISCLOSED_DOWNGRADE",
        "CORE_TASK_BLOCKED"
      ]
    },
    "user_personalization_preserved": {
      "type": "boolean"
    },
    "user_template_assets_preserved": {
      "type": "boolean"
    },
    "disclosure_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
