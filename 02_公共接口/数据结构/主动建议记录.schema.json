{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/proactive-suggestion/0.1",
  "title": "ProactiveSuggestion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suggestion_id",
    "status",
    "reason",
    "directly_related_to_current_goal"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "suggestion_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "SHOWN",
        "ACCEPTED",
        "DECLINED",
        "SUPPRESSED"
      ]
    },
    "reason": {
      "type": "string"
    },
    "suggested_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "directly_related_to_current_goal": {
      "type": "boolean"
    },
    "legal_basis_required": {
      "type": "boolean"
    },
    "is_mandatory_claim": {
      "type": "boolean"
    },
    "human_decision_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
