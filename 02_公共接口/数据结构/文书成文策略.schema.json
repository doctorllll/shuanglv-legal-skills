{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schema/document-composition-plan/0.1",
  "title": "DocumentCompositionPlan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "plan_id",
    "document_type",
    "primary_reader",
    "desired_decision_or_action",
    "selected_entry_angle",
    "core_arguments",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "plan_id": {
      "type": "string"
    },
    "matter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_type": {
      "type": "string"
    },
    "procedural_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "represented_party": {
      "type": [
        "string",
        "null"
      ]
    },
    "primary_reader": {
      "type": "string"
    },
    "secondary_readers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "desired_decision_or_action": {
      "type": "string"
    },
    "decision_friction": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_entry_angles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "angle",
          "pros",
          "cons"
        ],
        "properties": {
          "angle": {
            "type": "string"
          },
          "pros": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "selected_entry_angle": {
      "type": "string"
    },
    "core_arguments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "argument_id",
          "proposition",
          "priority",
          "purpose"
        ],
        "properties": {
          "argument_id": {
            "type": "string"
          },
          "proposition": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "purpose": {
            "type": "string"
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterreasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depth": {
            "enum": [
              "BRIEF",
              "NORMAL",
              "DEEP"
            ]
          }
        }
      }
    },
    "excluded_internal_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "reason"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "depth_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "argument_id",
          "depth",
          "reason"
        ],
        "properties": {
          "argument_id": {
            "type": "string"
          },
          "depth": {
            "enum": [
              "BRIEF",
              "NORMAL",
              "DEEP"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "tone_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "post_hearing_revision": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "enum": [
        "DRAFT",
        "CONFIRMED",
        "REVISED",
        "FINAL"
      ]
    }
  }
}
