{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/provenance-link/0.1",
  "title": "溯源关系记录 ProvenanceLink",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "link_id",
    "from_ref",
    "relation",
    "to_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "link_id": {
      "type": "string",
      "minLength": 1
    },
    "from_ref": {
      "type": "string",
      "minLength": 1
    },
    "from_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "relation": {
      "enum": [
        "LOCATED_AT",
        "DERIVED_FROM",
        "SUPPORTED_BY",
        "CONTRADICTED_BY",
        "APPLIES_RULE",
        "USES_CASE",
        "RESPONDS_TO",
        "DISTINGUISHES",
        "SUMMARIZES",
        "EXPRESSED_AS",
        "DEPENDS_ON",
        "OTHER"
      ]
    },
    "to_ref": {
      "type": "string",
      "minLength": 1
    },
    "to_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
