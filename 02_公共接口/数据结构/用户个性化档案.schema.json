{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/user-personalization-profile/0.1",
  "title": "用户个性化档案 UserPersonalizationProfile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_type",
    "created_at",
    "settings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_type": {
      "const": "USER"
    },
    "owner_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_migrated_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_migrated_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_upgrade_policy": {
      "enum": [
        "PRESERVE_USER",
        "ADOPT_NEW_DEFAULTS",
        "REVIEW_ALL"
      ]
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "https://shuanglv.local/schemas/personalization-item/0.1"
      }
    },
    "custom_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_type",
          "path"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "asset_type": {
            "enum": [
              "RULE",
              "TEMPLATE",
              "WORKFLOW",
              "OTHER"
            ]
          },
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DISABLED",
              "REVIEW_REQUIRED"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "template_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
