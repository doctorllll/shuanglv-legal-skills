{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/source-card/0.3",
  "title": "SourceCard / SourceProfile v0.3",
  "required": [
    "schema_version",
    "source_id",
    "source_family",
    "source_type",
    "title",
    "verification_state"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2",
        "0.3"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "source_family": {
      "enum": [
        "LEGAL_AUTHORITY",
        "CASE",
        "PROFESSIONAL_COMMENTARY",
        "PUBLIC_PLATFORM",
        "PRIVATE_KNOWLEDGE",
        "MATTER_EVIDENCE",
        "METHODOLOGY"
      ]
    },
    "source_type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "author_or_authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "publisher_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_channel": {
      "type": [
        "string",
        "null"
      ]
    },
    "official_account_state": {
      "enum": [
        "OFFICIAL_VERIFIED",
        "OFFICIAL_UNVERIFIED",
        "NON_OFFICIAL",
        "UNKNOWN",
        null
      ]
    },
    "originality_state": {
      "enum": [
        "ORIGINAL_PRIMARY",
        "OFFICIAL_REPUBLICATION",
        "SECONDARY_REPUBLICATION",
        "EXCERPT",
        "UNKNOWN",
        null
      ]
    },
    "source_role": {
      "type": "array",
      "items": {
        "enum": [
          "FORMAL_NORM",
          "OFFICIAL_CASE",
          "JUDGMENT",
          "OFFICIAL_INTERPRETATION",
          "PRACTICE_SIGNAL",
          "SCHOLARLY_VIEW",
          "PROFESSIONAL_ANALYSIS",
          "RESEARCH_LEAD",
          "MATTER_FACT",
          "OTHER"
        ]
      }
    },
    "publication_or_issue_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_nature": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "validity_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "professional_authority": {
      "enum": [
        "VERY_HIGH",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN",
        null
      ]
    },
    "normative_force": {
      "enum": [
        "FORMAL_BINDING",
        "FORMAL_NONBINDING",
        "INTERPRETIVE_ONLY",
        "PRACTICE_REFERENCE",
        "SCHOLARLY_OR_PROFESSIONAL",
        "NONE",
        "UNKNOWN",
        null
      ]
    },
    "fact_proof_weight": {
      "enum": [
        "PRIMARY_EVIDENCE",
        "OFFICIAL_RECORD",
        "SECONDARY_INFORMATION",
        "COMMENTARY_ONLY",
        "NOT_FOR_FACT_PROOF",
        "UNKNOWN",
        null
      ]
    },
    "verification_state": {
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "UNVERIFIED",
        "CONFLICTED"
      ]
    },
    "stance": {
      "enum": [
        "SUPPORT",
        "COUNTER",
        "NEUTRAL",
        "MIXED",
        "NOT_APPLICABLE"
      ]
    },
    "related_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "locators": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "supported_propositions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permitted_uses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_further_verification": {
      "type": "boolean"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_family": {
            "enum": [
              "LEGAL_AUTHORITY",
              "CASE"
            ]
          },
          "verification_state": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "source_family",
          "verification_state"
        ]
      },
      "then": {
        "properties": {
          "locators": {
            "minItems": 1
          }
        },
        "required": [
          "locators"
        ]
      }
    }
  ]
}
