{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/plan-review/0.1",
  "title": "执行计划确认记录 PlanReviewRecord v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "plan_review_id",
    "matter_id",
    "execution_plan_id",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "plan_review_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "execution_plan_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "NOT_REQUIRED",
        "PROPOSED",
        "APPROVED",
        "APPROVED_WITH_CHANGES",
        "REVISED",
        "REJECTED"
      ]
    },
    "confirmation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "added_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modified_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_or_lawyer_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_plan_review_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
