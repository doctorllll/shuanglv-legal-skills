{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/fact-record/0.2",
  "title": "FactRecord v0.2",
  "required": [
    "schema_version",
    "fact_id",
    "matter_id",
    "statement",
    "fact_status",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "fact_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "fact_status": {
      "enum": [
        "VERIFIED",
        "ALLEGED",
        "DISPUTED",
        "INFERRED",
        "UNKNOWN"
      ]
    },
    "materiality": {
      "enum": [
        "MATERIAL",
        "POTENTIALLY_MATERIAL",
        "BACKGROUND",
        "UNKNOWN"
      ]
    },
    "time": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "actors": {
      "type": "array"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "supports_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradicts_fact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inference_basis": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "review_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    },
    "supporting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inference_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "competing_explanations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fact_status": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "fact_status"
        ]
      },
      "then": {
        "properties": {
          "source_refs": {
            "minItems": 1
          }
        },
        "required": [
          "source_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "fact_status": {
            "const": "INFERRED"
          }
        },
        "required": [
          "fact_status"
        ]
      },
      "then": {
        "properties": {
          "source_refs": {
            "minItems": 1
          },
          "inference_basis": {
            "minItems": 1
          }
        },
        "required": [
          "source_refs",
          "inference_basis"
        ]
      }
    }
  ]
}
