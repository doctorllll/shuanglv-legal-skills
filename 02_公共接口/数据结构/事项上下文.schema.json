{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/matter-context/0.1",
  "title": "MatterContext",
  "required": [
    "schema_version",
    "matter_id",
    "matter_type",
    "title",
    "jurisdiction",
    "roles",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "matter_id": {
      "type": "string"
    },
    "matter_type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "jurisdiction": {
      "type": [
        "string",
        "array"
      ]
    },
    "roles": {
      "type": "array"
    },
    "status": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "client_or_principal": {
      "type": [
        "string",
        "null"
      ]
    },
    "counterparties": {
      "type": "array"
    },
    "business_goal": {
      "type": [
        "string",
        "null"
      ]
    },
    "procedural_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "material_dates": {
      "type": "array"
    },
    "confidentiality": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    }
  }
}