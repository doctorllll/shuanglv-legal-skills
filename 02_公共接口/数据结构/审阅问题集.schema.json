{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/review-question-set/0.1",
  "title": "审阅问题集 ReviewQuestionSet v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "question_set_id",
    "matter_id",
    "purpose",
    "questions",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "question_set_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "applies_to_material_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "label",
          "question",
          "answer_type",
          "source_locator_required"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer_type": {
            "enum": [
              "TEXT",
              "DATE",
              "AMOUNT",
              "NUMBER",
              "BOOLEAN",
              "ENUM",
              "REFERENCE",
              "MULTI_VALUE",
              "OTHER"
            ]
          },
          "allowed_values": {
            "type": "array"
          },
          "source_locator_required": {
            "type": "boolean"
          },
          "comparison_mode": {
            "enum": [
              "NONE",
              "CROSS_DOCUMENT",
              "CROSS_PARTY",
              "CROSS_VERSION",
              "TIME_SERIES",
              "OTHER"
            ]
          },
          "linked_issue_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_value_policy": {
            "enum": [
              "UNKNOWN",
              "NOT_FOUND",
              "NOT_APPLICABLE",
              "NEEDS_REVIEW"
            ]
          }
        }
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "REVISED",
        "CLOSED"
      ]
    },
    "supersedes_question_set_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
