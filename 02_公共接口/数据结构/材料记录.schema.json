{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/material-record.schema.json",
  "title": "材料记录 MaterialRecord",
  "type": "object",
  "required": ["material_id", "name", "review_status"],
  "properties": {
    "material_id": {"type": "string"},
    "name": {"type": "string"},
    "material_type": {"type": ["string", "null"]},
    "source": {"type": ["string", "null"]},
    "date_created": {"type": ["string", "null"]},
    "date_received": {"type": ["string", "null"]},
    "review_status": {
      "type": "string",
      "enum": ["RECEIVED", "REVIEWED", "PARTIAL", "UNREADABLE"]
    },
    "source_locators": {
      "type": "array",
      "items": {"type": "object"}
    },
    "actors": {"type": "array", "items": {"type": "string"}},
    "events_or_topics": {"type": "array", "items": {"type": "string"}},
    "fact_contributions": {"type": "array", "items": {"type": "string"}},
    "adverse_content": {"type": "array", "items": {"type": "string"}},
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "linked_issue_ids": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
