{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/source-locator/0.2",
  "title": "SourceLocator v0.2",
  "required": [
    "schema_version",
    "source_id",
    "source_type",
    "file_or_resource",
    "locator_type",
    "locator_value"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "file_or_resource": {
      "type": "string"
    },
    "locator_type": {
      "enum": [
        "page",
        "line",
        "paragraph",
        "sheet_cell",
        "slide",
        "timestamp",
        "frame",
        "url_section",
        "message_id",
        "database_record",
        "other"
      ]
    },
    "locator_value": {},
    "original_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "hash_or_integrity_marker": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    },
    "locator_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "quoted_excerpt": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_state": {
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "UNVERIFIED",
        "NOT_APPLICABLE"
      ]
    }
  }
}
