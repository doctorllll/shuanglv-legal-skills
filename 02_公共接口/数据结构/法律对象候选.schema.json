{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/legal-object-candidate/0.1",
  "title": "法律对象候选 LegalObjectCandidate v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "candidate_id",
    "material_id",
    "object_type",
    "extracted_text",
    "extraction_state",
    "verification_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "candidate_id": {
      "type": "string"
    },
    "material_id": {
      "type": "string"
    },
    "source_locator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "object_type": {
      "enum": [
        "PERSON",
        "ORGANIZATION",
        "EVENT",
        "DATE",
        "AMOUNT",
        "RELATION",
        "DOCUMENT",
        "CLAIM",
        "LEGAL_TERM",
        "OTHER"
      ]
    },
    "extracted_text": {
      "type": "string"
    },
    "normalized_fields": {
      "type": "object"
    },
    "extraction_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "extraction_state": {
      "enum": [
        "EXTRACTED",
        "AMBIGUOUS",
        "CONFLICTING",
        "UNREADABLE"
      ]
    },
    "verification_status": {
      "enum": [
        "NOT_VERIFIED",
        "VERIFIED",
        "REJECTED"
      ]
    },
    "linked_object_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
