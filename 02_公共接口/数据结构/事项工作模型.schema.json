{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/matter-working-model/0.1",
  "title": "事项工作模型 MatterWorkingModel v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "model_id",
    "matter_id",
    "status",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "matter_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "task_profile_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "research_request_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "research_result_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "case_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_map_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "case_matrix_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "argument_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "argument_map_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "option_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverable_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_writeback_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "NEEDS_UPDATE",
        "BLOCKED",
        "CLOSED_FOR_CURRENT_TASK"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
