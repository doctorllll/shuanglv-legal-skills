{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/upgrade-migration-report/0.1",
  "title": "升级迁移报告 UpgradeMigrationReport v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "from_version",
    "to_version",
    "policy",
    "status",
    "summary",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "from_version": {
      "type": "string"
    },
    "to_version": {
      "type": "string"
    },
    "policy": {
      "enum": [
        "PRESERVE_USER",
        "ADOPT_NEW_DEFAULTS",
        "REVIEW_ALL"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "PASS_WITH_REVIEW",
        "BLOCKED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "required": [
        "preserved",
        "migrated",
        "review_required",
        "blocked",
        "orphaned"
      ],
      "properties": {
        "preserved": {
          "type": "integer"
        },
        "migrated": {
          "type": "integer"
        },
        "review_required": {
          "type": "integer"
        },
        "blocked": {
          "type": "integer"
        },
        "orphaned": {
          "type": "integer"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "setting_id",
          "key",
          "result"
        ],
        "properties": {
          "setting_id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PRESERVED",
              "MIGRATED",
              "ADOPTED_NEW_DEFAULT",
              "REVIEW_REQUIRED",
              "BLOCKED_BY_GUARDRAIL",
              "ORPHANED",
              "DISABLED"
            ]
          },
          "old_value": {},
          "new_value": {},
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "legacy_core_customizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "MODIFIED",
              "ADDED",
              "DELETED"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "snapshot_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
