{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/deliverable-claim/0.1",
  "title": "交付命题记录 DeliverableClaim",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "claim_id",
    "matter_id",
    "statement",
    "claim_type",
    "importance",
    "traceability_state"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "matter_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_locator": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "enum": [
        "FACT",
        "LEGAL_RULE",
        "LEGAL_ANALYSIS",
        "EVIDENCE_ASSESSMENT",
        "STRATEGY",
        "RISK",
        "PROCEDURAL",
        "OTHER"
      ]
    },
    "importance": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "argument_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "case_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "locator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traceability_state": {
      "enum": [
        "FULL",
        "PARTIAL",
        "UNTRACED",
        "NOT_REQUIRED"
      ]
    },
    "uncertainty_note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "importance": {
            "enum": [
              "CRITICAL",
              "HIGH"
            ]
          },
          "traceability_state": {
            "const": "FULL"
          }
        },
        "required": [
          "importance",
          "traceability_state"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "finding_ids": {
                "minItems": 1
              }
            },
            "required": [
              "finding_ids"
            ]
          },
          {
            "properties": {
              "argument_ids": {
                "minItems": 1
              }
            },
            "required": [
              "argument_ids"
            ]
          },
          {
            "properties": {
              "fact_ids": {
                "minItems": 1
              }
            },
            "required": [
              "fact_ids"
            ]
          },
          {
            "properties": {
              "rule_ids": {
                "minItems": 1
              }
            },
            "required": [
              "rule_ids"
            ]
          },
          {
            "properties": {
              "source_ids": {
                "minItems": 1
              }
            },
            "required": [
              "source_ids"
            ]
          }
        ]
      }
    }
  ]
}
