{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/risk-record/0.2",
  "title": "RiskRecord",
  "required": [
    "schema_version",
    "risk_id",
    "matter_id",
    "scenario",
    "impact",
    "status",
    "owner_skill"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "risk_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "trigger": {
      "type": [
        "string",
        "null"
      ]
    },
    "likelihood": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN",
        "NOT_ASSESSED"
      ]
    },
    "impact": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "controllability": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN",
        "NOT_ASSESSED"
      ]
    },
    "supporting_fact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supporting_finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supporting_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mitigation_options": {
      "type": "array"
    },
    "residual_risk": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "client_decision_required": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "OPEN",
        "MITIGATED",
        "ACCEPTED",
        "TRANSFERRED",
        "AVOIDED",
        "HUMAN_REVIEW",
        "CLOSED"
      ]
    },
    "owner_skill": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  }
}