{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/template-asset-registry/0.1",
  "title": "模板资产清单 TemplateAssetRegistry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "name",
          "scope",
          "document_types",
          "file_path",
          "format",
          "source_type",
          "application_mode",
          "status"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "USER",
              "MATTER",
              "CLIENT_OR_PROJECT"
            ]
          },
          "scope_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "document_types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "file_path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "DOCX",
              "MD",
              "TXT",
              "HTML",
              "PDF_REFERENCE",
              "OTHER"
            ]
          },
          "source_type": {
            "enum": [
              "USER_PROVIDED",
              "USER_CONFIRMED",
              "MIGRATED_LEGACY"
            ]
          },
          "application_mode": {
            "enum": [
              "STRICT_STRUCTURE",
              "GUIDED_STRUCTURE",
              "STYLE_REFERENCE"
            ]
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DISABLED",
              "REVIEW_REQUIRED"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "version_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
