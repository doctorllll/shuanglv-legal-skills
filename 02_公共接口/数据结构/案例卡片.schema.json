{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/case-card/0.1",
  "title": "CaseCard",
  "required": [
    "schema_version",
    "case_id",
    "source_id",
    "legal_issue_ids",
    "material_facts",
    "rules_or_holdings",
    "verification_state"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "case_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "court_or_authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "procedural_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "case_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "legal_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material_facts": {
      "type": "array"
    },
    "rules_or_holdings": {
      "type": "array"
    },
    "legal_basis": {
      "type": "array"
    },
    "authority_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "same_issue_state": {
      "enum": [
        "SAME",
        "RELATED",
        "DIFFERENT",
        "UNRESOLVED"
      ]
    },
    "material_fact_similarity": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNRESOLVED"
      ]
    },
    "normative_background_similarity": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNRESOLVED"
      ]
    },
    "intended_use": {
      "type": "array",
      "items": {
        "enum": [
          "RULE_CASE",
          "FACT_PATTERN",
          "EVIDENCE_PATTERN",
          "SENTENCING",
          "COUNTER_CASE",
          "DISTINGUISHING",
          "PROCEDURAL",
          "POLICY_SIGNAL"
        ]
      }
    },
    "distinguishing_points": {
      "type": "array"
    },
    "support_direction": {
      "enum": [
        "SUPPORT",
        "COUNTER",
        "MIXED",
        "NEUTRAL"
      ]
    },
    "verification_state": {
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "UNVERIFIED",
        "CONFLICTED"
      ]
    },
    "extensions": {
      "type": "object"
    }
  }
}