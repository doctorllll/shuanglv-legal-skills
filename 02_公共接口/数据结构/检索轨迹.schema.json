{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/research-trace/0.2",
  "title": "ResearchTrace v0.2",
  "required": [
    "schema_version",
    "trace_id",
    "issue_id",
    "source_or_adapter",
    "query",
    "searched_at"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "trace_id": {
      "type": "string"
    },
    "issue_id": {
      "type": "string"
    },
    "source_or_adapter": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "query_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "filters": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "searched_at": {
      "type": "string"
    },
    "result_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "selected_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejection_reasons": {
      "type": "array"
    },
    "next_search_trigger": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    },
    "search_stage": {
      "enum": [
        "DIRECT",
        "ELEMENT_FACT",
        "ANALOGICAL",
        "SNOWBALL",
        "INTERPRETATION_PRACTICE",
        "OTHER",
        null
      ]
    },
    "discovery_channel": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_source_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluated_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "information_gain": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "NONE",
        "UNKNOWN",
        null
      ]
    },
    "material_new_issue_found": {
      "type": "boolean"
    },
    "saturation_effect": {
      "enum": [
        "NOT_ASSESSED",
        "MOVES_TOWARD_SATURATION",
        "NO_MATERIAL_CHANGE",
        "REOPENS_RESEARCH",
        "UNKNOWN"
      ]
    }
  }
}
