{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/version-migration-manifest/0.1",
  "title": "版本迁移清单 VersionMigrationManifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "from_version",
    "to_version",
    "default_policy",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "from_version": {
      "type": "string"
    },
    "to_version": {
      "type": "string"
    },
    "default_policy": {
      "enum": [
        "PRESERVE_USER",
        "ADOPT_NEW_DEFAULTS",
        "REVIEW_ALL"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "change_id",
          "change_type",
          "description"
        ],
        "properties": {
          "change_id": {
            "type": "string"
          },
          "change_type": {
            "enum": [
              "CORE_FIX",
              "CORE_CAPABILITY",
              "DEFAULT_CHANGE",
              "BREAKING_CHANGE"
            ]
          },
          "description": {
            "type": "string"
          },
          "affected_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "new_default": {},
          "migration_action": {
            "enum": [
              "NONE",
              "AUTO_RENAME",
              "AUTO_TRANSFORM",
              "REVIEW_REQUIRED",
              "BLOCK_OLD_OVERRIDE"
            ]
          },
          "replacement_key": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "hard_guardrail_prefixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "renamed_keys": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "removed_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
