{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/behavior-contract-record/0.1",
  "title": "技能行为契约记录 BehaviorContractRecord v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "record_id",
    "matter_id",
    "checks",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "contract_id",
          "status"
        ],
        "properties": {
          "contract_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_APPLICABLE",
              "NOT_CHECKED"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "affected_ref_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "critical_violation_count": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "PASS",
        "BLOCKED",
        "PASS_WITH_NOTES"
      ]
    }
  }
}
