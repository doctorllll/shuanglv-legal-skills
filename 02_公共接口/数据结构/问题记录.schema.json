{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://legal-skill.local/schema/issue-record/0.3",
  "title": "IssueRecord v0.3",
  "required": [
    "schema_version",
    "issue_id",
    "matter_id",
    "question",
    "issue_type",
    "status"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2",
        "0.3"
      ]
    },
    "issue_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "issue_type": {
      "type": "string"
    },
    "status": {
      "enum": [
        "OPEN",
        "RESEARCHING",
        "PROVISIONALLY_RESOLVED",
        "RESOLVED",
        "BLOCKED",
        "HUMAN_REVIEW"
      ]
    },
    "priority": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "dependent_fact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sub_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent_issue_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "research_scope": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "resolution_required": {
      "type": "boolean"
    },
    "extensions": {
      "type": "object"
    },
    "source_fact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_case_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "research_request_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "research_result_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "option_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_writeback_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
