{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/research-saturation-assessment/0.1",
  "title": "研究充分性判断 ResearchSaturationAssessment v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "assessment_id",
    "issue_id",
    "status",
    "assessed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "SATURATED",
        "INCOMPLETE",
        "BLOCKED",
        "HUMAN_REVIEW_REQUIRED"
      ]
    },
    "core_norm_verified": {
      "type": "boolean"
    },
    "time_applicability_checked": {
      "type": "boolean"
    },
    "independent_search_path_count": {
      "type": "integer",
      "minimum": 0
    },
    "support_path_checked": {
      "type": "boolean"
    },
    "counter_path_checked": {
      "type": "boolean"
    },
    "boundary_path_checked": {
      "type": "boolean"
    },
    "exception_path_checked": {
      "type": "boolean"
    },
    "official_interpretation_or_practice_checked_when_material": {
      "type": "boolean"
    },
    "theory_or_professional_analysis_checked_when_material": {
      "type": "boolean"
    },
    "latest_information_gain": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "NONE",
        "UNKNOWN"
      ]
    },
    "remaining_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gap_can_change_conclusion": {
      "type": "boolean"
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "assessed_at": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SATURATED"
          }
        }
      },
      "then": {
        "properties": {
          "gap_can_change_conclusion": {
            "const": false
          }
        },
        "required": [
          "gap_can_change_conclusion",
          "stop_reason"
        ]
      }
    }
  ]
}
