{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/shared-matter-fields/0.1",
  "title": "共享事项字段 SharedMatterFields v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "matter_id",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_id",
          "key",
          "label",
          "value",
          "fact_status"
        ],
        "properties": {
          "field_id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {},
          "fact_status": {
            "enum": [
              "VERIFIED",
              "ALLEGED",
              "DISPUTED",
              "INFERRED",
              "UNKNOWN"
            ]
          },
          "fact_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locator_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
