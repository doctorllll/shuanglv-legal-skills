{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/task-profile/0.1",
  "title": "任务配置 TaskProfile v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "profile_id",
    "matter_id",
    "task_goal",
    "scope",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "matter_id": {
      "type": "string",
      "minLength": 1
    },
    "task_goal": {
      "type": "string",
      "minLength": 1
    },
    "client_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "procedural_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNSPECIFIED"
      ]
    },
    "urgency": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNSPECIFIED"
      ]
    },
    "risk_appetite": {
      "enum": [
        "CONSERVATIVE",
        "BALANCED",
        "AGGRESSIVE",
        "UNSPECIFIED",
        "NOT_APPLICABLE"
      ]
    },
    "negotiation_position": {
      "enum": [
        "STRONG",
        "BALANCED",
        "WEAK",
        "UNSPECIFIED",
        "NOT_APPLICABLE"
      ]
    },
    "review_mode": {
      "enum": [
        "BALANCED",
        "PROTECTIVE",
        "MINIMAL_CHANGE",
        "ISSUE_SPOTTING",
        "CUSTOM",
        "NOT_APPLICABLE"
      ]
    },
    "non_negotiables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback_positions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "COMPLETE",
        "NEEDS_USER_INPUT",
        "SUPERSEDED"
      ]
    },
    "supersedes_profile_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
