{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/option-record/0.1",
  "title": "策略选项记录 OptionRecord v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version","option_id","matter_id","issue_id","label","description","status"],
  "properties": {
    "schema_version": {"const":"0.1"},
    "option_id": {"type":"string","minLength":1},
    "matter_id": {"type":"string","minLength":1},
    "issue_id": {"type":"string","minLength":1},
    "label": {"type":"string","minLength":1},
    "description": {"type":"string","minLength":1},
    "prerequisites": {"type":"array","items":{"type":"string"}},
    "supporting_fact_ids": {"type":"array","items":{"type":"string"}},
    "supporting_rule_ids": {"type":"array","items":{"type":"string"}},
    "supporting_argument_ids": {"type":"array","items":{"type":"string"}},
    "benefits": {"type":"array","items":{"type":"string"}},
    "risks": {"type":"array","items":{"type":"string"}},
    "likely_responses": {"type":"array","items":{"type":"string"}},
    "information_gaps": {"type":"array","items":{"type":"string"}},
    "flip_conditions": {"type":"array","items":{"type":"string"}},
    "reversibility": {"enum":["REVERSIBLE","PARTIALLY_REVERSIBLE","IRREVERSIBLE","UNKNOWN"]},
    "recommendation_state": {"enum":["PREFERRED","ALTERNATIVE","BACKUP","NOT_RECOMMENDED","UNRESOLVED"]},
    "recommendation_reason": {"type":["string","null"]},
    "status": {"enum":["DRAFT","AVAILABLE","SELECTED","REJECTED","SUPERSEDED","BLOCKED"]},
    "extensions": {"type":"object"}
  }
}
