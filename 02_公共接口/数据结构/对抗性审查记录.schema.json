{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuanglv.local/schemas/adversarial-review-record/0.1",
  "title": "对抗性审查记录 AdversarialReviewRecord v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version","review_id","matter_id","target_finding_ids","initial_position","strongest_opposing_model","status"],
  "properties": {
    "schema_version": {"const":"0.1"},
    "review_id": {"type":"string","minLength":1},
    "matter_id": {"type":"string","minLength":1},
    "target_finding_ids": {"type":"array","minItems":1,"items":{"type":"string"}},
    "target_argument_ids": {"type":"array","items":{"type":"string"}},
    "initial_position": {"type":"string","minLength":1},
    "strongest_opposing_model": {"type":"string","minLength":1},
    "adverse_fact_ids": {"type":"array","items":{"type":"string"}},
    "adverse_evidence_ids": {"type":"array","items":{"type":"string"}},
    "counter_rule_ids": {"type":"array","items":{"type":"string"}},
    "counter_case_ids": {"type":"array","items":{"type":"string"}},
    "vulnerabilities": {"type":"array","items":{"type":"string"}},
    "flip_points": {"type":"array","items":{"type":"string"}},
    "resolution_actions": {"type":"array","items":{"type":"string"}},
    "revised_argument_ids": {"type":"array","items":{"type":"string"}},
    "revised_finding_ids": {"type":"array","items":{"type":"string"}},
    "unchanged_reason": {"type":["string","null"]},
    "requires_additional_research": {"type":"boolean"},
    "requires_additional_material": {"type":"boolean"},
    "requires_human_review": {"type":"boolean"},
    "status": {"enum":["PENDING","COMPLETE_REVISED","COMPLETE_UNCHANGED_WITH_REASON","BLOCKED"]},
    "extensions": {"type":"object"}
  },
  "allOf": [
    {
      "if": {"properties":{"status":{"const":"COMPLETE_REVISED"}},"required":["status"]},
      "then": {"anyOf":[{"required":["revised_argument_ids"]},{"required":["revised_finding_ids"]}]}
    },
    {
      "if": {"properties":{"status":{"const":"COMPLETE_UNCHANGED_WITH_REASON"}},"required":["status"]},
      "then": {"required":["unchanged_reason"]}
    }
  ]
}
